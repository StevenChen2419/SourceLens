# Optional setting. Copy this file to backend/.env and replace the placeholder.
# Leave commented to use the default application name (SourceLens).
# KNOWLEDGEOPS_APP_NAME=<application-name>
# Local defaults; the Docker image defaults to production instead.
KNOWLEDGEOPS_ENVIRONMENT=development
KNOWLEDGEOPS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Azure container: set production, one exact HTTPS frontend origin, and
# AZURE_TOKEN_CREDENTIALS=ManagedIdentityCredential in host environment variables.
# Do not copy this development .env into the image. See docs/deployment.md.
# Required for document uploads: HTTPS Blob service URL, without credentials.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=documents
MAX_UPLOAD_SIZE_MB=10
# Authenticate with az login; do not add keys, connection strings, or SAS tokens.

# Required only when invoking embedding generation. Use the Azure OpenAI v1 URL.
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=knowledgeops-chunks

# Default number of retrieved chunks (1-20); requests can override with top_k.
RETRIEVAL_TOP_K=5

# GPT-5-mini generation deployment; use its Azure OpenAI v1 endpoint.
AZURE_GENERATION_ENDPOINT=
AZURE_GENERATION_DEPLOYMENT=
GENERATION_CONTEXT_TOKENS=8000
GENERATION_MAX_COMPLETION_TOKENS=4096
