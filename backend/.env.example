# Optional setting. Copy this file to backend/.env and replace the placeholder.
# Leave commented to use the default application name (KnowledgeOps).
# KNOWLEDGEOPS_APP_NAME=<application-name>
# Required for document uploads: HTTPS Blob service URL, without credentials.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONTAINER=documents
MAX_UPLOAD_SIZE_MB=10
# Authenticate with az login; do not add keys, connection strings, or SAS tokens.

# Required only when invoking embedding generation. Use the Azure OpenAI v1 URL.
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=16
